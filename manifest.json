{
  "manifest_version": 3,
  "name": "网络流量统计大师",
  "version": "2.1",
  "description": "实时统计网页浏览流量，支持日/月/年平滑曲线报表、域名流量排行与无缝数据继承。",
  "permissions": [
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}